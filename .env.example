# Bot-Token aus dem Discord Developer Portal (NIEMALS teilen oder hochladen!)
DISCORD_TOKEN=dein_bot_token_hier

# Standard-Channel fuer News (Rechtsklick auf Channel -> "Kanal-ID kopieren").
# Kann spaeter pro Server mit /setchannel ueberschrieben werden.
NEWS_CHANNEL_ID=

# Alternativ: Channel-Name, der auf jedem Server automatisch gesucht wird
NEWS_CHANNEL_NAME=stonks

# Wie oft nach neuen News gesucht wird (Minuten)
POLL_INTERVAL_MINUTES=10

# Maximale Anzahl Posts pro Durchlauf (verhindert Spam)
MAX_POSTS_PER_CYCLE=5

# Optional: nur News posten, die eines dieser Woerter enthalten (kommagetrennt, leer = alle)
# Beispiel: KEYWORDS=DAX,Aktie,Fed,EZB,Zinsen,Bitcoin,Nasdaq
KEYWORDS=

# Artikel-Seite zusaetzlich abrufen, um Vorschaubild und laengere Beschreibung zu holen (true/false)
ENRICH_ARTICLES=true
